# Copy this file to ".env" and fill in your keys. Never commit or share ".env".

# Google Cloud key with the "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# Brave Search API key (brave.com/search/api) — optional but strongly
# recommended. Without it, filling missing contacts falls back to Claude's
# web search, which was measured at 81% of a run's cost. With it, the app
# searches with Brave and reads the pages itself for free. Brave's free tier
# is 2,000 queries/month at 1 query/second.
BRAVE_API_KEY=

# Set to 1 to test the app with sample data and NO live API calls.
MOCK_MODE=0